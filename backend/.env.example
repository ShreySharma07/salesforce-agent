# =================== LLM ====================
# There are TWO model jobs and they can use different providers.
#
# 1) The video -> plan pipeline (keyframe captioning + plan synthesis).
#    Runs once per recording. Works on either provider.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
#
#    All-Claude pipeline instead (needs: pip install -e ".[anthropic]"):
     LLM_PROVIDER=anthropic
     LLM_MODEL=claude-sonnet-5
#
#    The pipeline has two stages with very different cost profiles, and on a
#    small budget it is worth splitting them. Captioning sends every keyframe
#    as an image, so it dominates token spend while being an easy task; plan
#    synthesis is ONE call that must follow a long rule list. Both default to
#    LLM_MODEL when unset.
# CAPTION_LLM_MODEL=claude-haiku-4-5
# PLAN_LLM_MODEL=claude-opus-5

# 2) The ReAct loop inside the sandbox (screenshot -> reason -> act).
#    Many small calls that must return strict JSON and follow a long rule
#    list. This is the run's cost centre and where model quality shows most.
#    Leave BOTH unset to use the same model as the pipeline above.
#    Requires: pip install -e ".[anthropic]"
# SANDBOX_LLM_PROVIDER=anthropic
# SANDBOX_LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
#
# Note: if SANDBOX_LLM_PROVIDER differs from LLM_PROVIDER you MUST also set
# SANDBOX_LLM_MODEL — the backend refuses to send a model id to the wrong
# provider. The sandbox itself holds no key either way; every call is proxied
# through the backend.

# =================== Sandbox runner ==========
SANDBOX_RUNNER=local_docker
SANDBOX_IMAGE=agent-sandbox:latest
SANDBOX_DEFAULT_MAX_STEPS=50
SANDBOX_DEFAULT_MAX_SECONDS=600
# How many sandboxes may run at once. local_docker binds a host port per
# container, so leave this small on a laptop.
MAX_CONCURRENT_RUNS=3

# Interface the sandbox's control port and live view are published on.
# LOOPBACK BY DEFAULT and it should stay that way: the live view is an
# unauthenticated VNC session with full control of a logged-in browser.
SANDBOX_BIND_HOST=127.0.0.1
# Required before exposing the live view beyond localhost. When set, the
# in-container VNC server demands this password.
# SANDBOX_VNC_PASSWORD=

# =================== Per-run budget ==========
# Enforced by the LLM proxy. A run that hits either ceiling is refused
# further model calls and aborts instead of burning the rest of the quota.
# The shipped defaults are effectively "no limit". If you are working against
# prepaid credits, set a real ceiling: this is what stops one confused run
# from draining the balance. A typical Salesforce run costs well under $2.
DEFAULT_MAX_MODEL_CALLS_PER_RUN=80000
DEFAULT_MAX_USD_PER_RUN=900.00

# =================== Database ================
# SQLite for dev (zero setup, file appears in .local_storage/dev.db)
DATABASE_URL=sqlite+aiosqlite:///./.local_storage/dev.db
# For prod, switch to Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/agent
AUTO_MIGRATE=true

# =================== Vault (REQUIRED) =========
# Generate ONE TIME with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit this. NEVER regenerate (you'll lose access to all encrypted credentials).
VAULT_ENCRYPTION_KEY=

# =================== OAuth ====================
# Where OAuth providers redirect back to. Must match what's registered
# in the provider's developer console.
PUBLIC_BACKEND_BASE_URL=http://localhost:8001

# Salesforce Connected App
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Use https://test.salesforce.com for Salesforce sandboxes
SALESFORCE_AUTH_URL=https://login.salesforce.com

# Google OAuth (Gmail, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# =================== Misc =====================
LOCAL_STORAGE_ROOT=./.local_storage
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
# Browser origins allowed to call the API with the session cookie.
# Comma-separated, never "*" (credentials require explicit origins).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_USER_ID=user_local
# true = an unauthenticated request resolves to DEFAULT_USER_ID (local dev
# and CLI tooling). MUST be false in production, where a missing session
# then returns 401.
AUTH_DEV_MODE=true
